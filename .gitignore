```gitignore
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter Notebook
.ipynb_checkpoints/

# Environment variables / secrets
.env

# Model files
*.pkl
*.joblib
*.h5
*.keras

# Large datasets
*.csv
*.zip
*.json

# Streamlit
.streamlit/secrets.toml

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Logs
*.log
```
